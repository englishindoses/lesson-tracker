# Copy this file to ".env" and paste in the two values from your Supabase project.
# Supabase dashboard -> your project -> Project Settings -> API
#
# These are the PUBLIC values. The anon key is designed to be shipped in a
# browser app; Row Level Security is what actually protects your rows.
# Never put the "service_role" key in here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
